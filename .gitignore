# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database, backups and WhatsApp session
/data/whatsapp/
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/backups/*.db

# member and gym photos
/public/uploads/members/*
!/public/uploads/members/.gitkeep
/public/uploads/gym/*
!/public/uploads/gym/.gitkeep

# google credentials
/secrets/*
!/secrets/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
