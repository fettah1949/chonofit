# Base SQLite. Le chemin est relatif au dossier prisma/.
DATABASE_URL="file:../data/gym.db"

# Secret de session (générez-en un avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"
AUTH_TRUST_HOST="true"

# URL utilisée par NextAuth. En accès réseau local, mettez l'adresse du PC de la salle.
AUTH_URL="http://localhost:5000"
NEXTAUTH_URL="http://localhost:5000"
